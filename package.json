{
   "name": "elitenovels",
   "version": "0.0.9",
   "description": "This is a template for the Elite Novels.",
   "author": "Sebastian Hilton (https://www.sebastianhilton.com)",
   "homepage": "https://www.elitenovels.com",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Meeovi/elitenovels-frontend"
   },
   "bugs": {
      "url": "https://github.com/Meeovi/elitenovels-frontend/issues"
   },
   "license": "MIT",
   "private": true,
   "scripts": {
      "elite-commit": "git add . && git commit -m \"ready for update\"",
      "elite-update": "git pull \"https://github.com/Meeovi/elitenovels-frontend\"",
      "build": "nuxt build",
      "prebuild": "node ./scripts/copy-images.js",
      "dev": "nuxt dev --port 3010",
      "ts-node": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}'",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "analyze": "nuxi analyze",
      "postinstall": "nuxt prepare"
   },
   "dependencies": {
      "@directus/sdk": "^21.2.0",
      "@directus/types": "^14.3.1",
      "@fortawesome/fontawesome-free": "^7.2.0",
      "@fortawesome/fontawesome-svg-core": "^7.2.0",
      "@fortawesome/free-solid-svg-icons": "^7.2.0",
      "@fortawesome/vue-fontawesome": "^3.1.3",
      "@mdi/font": "^7.4.47",
      "@nuxt/image": "^2.0.0",
      "@nuxtjs/leaflet": "^1.3.2",
      "@pinia/nuxt": "^0.11.3",
      "@vueuse/core": "^14.2.1",
      "algoliasearch": "^5.49.2",
      "eslint": "^10.1.0",
      "nuxt": "^4.4.2",
      "pinia": "^3.0.4",
      "vuetify-nuxt-module": "^0.19.5"
   },
   "devDependencies": {
      "@nuxtjs/turnstile": "^1.1.2",
      "@storefront-ui/nuxt": "^3.3.0"
   }
}